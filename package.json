{
  "name": "@j-meira/mui-theme",
  "version": "3.0.0",
  "description": "UI theme and form components built on MUI (Material UI) with Formik",
  "author": "J-Meira",
  "license": "ISC",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "default": "./dist/esm/index.js"
    },
    "./scss/*": "./dist/scss/*",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "keywords": [
    "theme",
    "material",
    "react"
  ],
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint-react/eslint-plugin": "^5.20.8",
    "@eslint/js": "^10.0.1",
    "@mui/material": "^9.4.0",
    "@mui/x-date-pickers": "^9.14.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.2",
    "dayjs": "^1.11.23",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-storybook": "10.6.0",
    "formik": "^2.4.9",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "notistack": "^3.0.2",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "sass": "^1.105.0",
    "storybook": "^10.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/J-Meira/mui-theme.git"
  },
  "peerDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/material": "^7.3.0 || ^9.0.0",
    "@mui/x-date-pickers": "^8.0.0 || ^9.0.0",
    "dayjs": "^1.11.0",
    "formik": "^2.4.0",
    "notistack": "^3.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.0.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "pnpm pre-build && pnpm build:esm && pnpm copy-scss",
    "build:esm": "tsc",
    "clean": "node scripts/clean.mjs",
    "copy-scss": "node scripts/copy.mjs",
    "pre-build": "pnpm prettier && pnpm lint  && pnpm clean",
    "prettier": "prettier --write \"{src,tests,example/src}/**/*.{js,ts,jsx,tsx}\"",
    "lint": "eslint .",
    "test": "vitest run",
    "sb": "storybook dev -p 6006",
    "sb-ssl": "storybook dev -p 6006 -h dev.jm.app.br --https --ssl-ca ./.ssl/ca.crt --ssl-cert ./.ssl/cert.crt --ssl-key ./.ssl/cert.key",
    "build-sb": "storybook build",
    "up-version": "pnpm version --no-git-tag-version",
    "pre-release": "pnpm pre-build && pnpm up-version",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
